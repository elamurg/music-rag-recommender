{
  "meta": {
    "version": "1.0",
    "total_queries": 100,
    "corpus": "music-rag-recommender, ~9500 tracks",
    "description": "Hand-crafted evaluation query set stratified across five categories that test different aspects of the SoundRAG system.",
    "categories": {
      "A": {
        "name": "genre",
        "count": 20,
        "ground_truth_strategy": "tag_match",
        "description": "Direct genre requests. Ground truth: any track whose track_tags or (fallback) artist_tags include any of the ground_truth_tags."
      },
      "B": {
        "name": "mood",
        "count": 20,
        "ground_truth_strategy": "tag_match",
        "description": "Emotional or atmospheric character requests. Ground truth: track whose tags include any of the ground_truth_tags. Mood tags are noisier than genre tags on Last.fm; some queries fall back to LLM-judge if tag coverage is thin."
      },
      "C": {
        "name": "compound",
        "count": 20,
        "ground_truth_strategy": "llm_judge",
        "description": "Compound queries combining genre + mood + context. Tests compositional reasoning that pure dense retrieval struggles with. Ground truth: LLM (Claude) judges each recommendation as relevant / partially relevant / not relevant."
      },
      "D": {
        "name": "reference",
        "count": 20,
        "ground_truth_strategy": "similar_artists",
        "description": "Reference-artist queries. Ground truth: track is correct if its artist appears in Last.fm's similar_tracks graph for the reference artist, or shares 2+ genre tags with the reference artist."
      },
      "E": {
        "name": "contextual",
        "count": 20,
        "ground_truth_strategy": "llm_judge",
        "description": "Context-based queries framed around real-life situations. Highly subjective. Ground truth: LLM judge."
      }
    },
    "eval_notes": {
      "tag_match_scoring": "A track is 'correct' if it has any of the ground_truth_tags. Use track_tags first; fall back to artist_tags. Case-insensitive matching. Precision@k and NDCG@k computed against this binary correctness signal.",
      "similar_artists_scoring": "A track is 'correct' if EITHER (a) its artist_name appears as target_artist in similar_tracks for any track by the reference artist, OR (b) its artist shares 2+ tags with the reference artist. Precision@k and NDCG@k computed against this binary signal.",
      "llm_judge_scoring": "Claude prompted with (query, recommended track's document_text, retrieved facts) and asked to score each on a 3-point scale: 2=highly relevant, 1=partially relevant, 0=not relevant. NDCG@k uses graded relevance.",
      "warning_thin_tags": "Before running evaluation, verify each ground_truth_tag has at least 30 tracks in track_tags OR artist_tags. If under 30, statistically underpowered and should be replaced."
    }
  },
